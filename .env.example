# Nutrient Python SDK license key. Leave empty to run in evaluation mode.
NUTRIENT_LICENSE_KEY=
# Pages OCR'd in parallel inside make_searchable (0 = one per CPU core).
NUTRIENT_OCR_THREADS=0
# Worker processes for one document (split mode). 1 = no split.
NUTRIENT_OCR_WORKERS=1
# OCR languages, combined with "+", for example dan+eng.
NUTRIENT_OCR_LANGUAGES=eng
